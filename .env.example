# OpenAI API Key for chat functionality
OPENAI_API_KEY=your-openai-api-key-here

# PostgreSQL Database URL
# ⚠️ WARNING: This app uses native PostgreSQL driver (pg), NOT Prisma Client
# ❌ DO NOT USE Prisma Accelerate URLs (db.prisma.io) - they will not work!

# ✅ RECOMMENDED: Vercel Postgres (Neon)
# Sign up at: https://vercel.com/postgres
DATABASE_URL=postgres://user:password@host.neon.tech:5432/dbname?sslmode=require

# ✅ Alternative: Supabase (great free tier)
# Sign up at: https://supabase.com
# DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres

# ✅ Alternative: Railway
# Sign up at: https://railway.app
# DATABASE_URL=postgresql://user:password@containers-us-west-123.railway.app:5432/railway

# ✅ Alternative: Local PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Optional: Firecrawl API key for web scraping
FIRECRAWL_API_KEY=your-firecrawl-api-key-here